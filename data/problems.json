    "title": "Valid Parentheses",
    "slug": "valid-parentheses",
    "difficulty": "Easy",
    "concept": "Stack (LIFO)",
    "tag": "String / Stack",
    "inputDesc": "s = \"({[]})\"",
    "goalDesc": "Verify brackets are closed by same type in correct order",
    "javaCode": [
      "class Solution {",
      "    public boolean isValid(String s) {",
      "        Deque<Character> stack = new ArrayDeque<>();",
      "        for (char c : s.toCharArray()) {",
      "            if (c == '(') stack.push(')');",
      "            else if (c == '{') stack.push('}');",
      "            else if (c == '[') stack.push(']');",
      "            else if (stack.isEmpty() || stack.pop() != c)",
      "                return false;",
      "        }",
      "        return stack.isEmpty();",
      "    }",
      "}"
    ],
    "time": "O(n)",
    "space": "O(n)",
    "tests": [
      { "id": "01", "name": "\"()[]{}\"", "res": "true" },
      { "id": "02", "name": "\"({[]})\"", "res": "true" },
      { "id": "03", "name": "\"(]\"", "res": "false" }
    ],
    "visualization": "stack",
    "runtime": "1ms (98.7%)",
    "memory": "41.5MB"
  },
  {
    "id": 3,
    "title": "Longest Substring",
    "slug": "longest-substring-without-repeating-characters",
    "difficulty": "Medium",
    "concept": "Sliding Window",
    "tag": "Two Pointers / Set",
    "inputDesc": "s = \"abcabcbb\"",
    "goalDesc": "Find length of longest substring without repeating chars",
    "javaCode": [
      "class Solution {",
      "    public int lengthOfLongestSubstring(String s) {",
      "        int[] last = new int[128];",
      "        Arrays.fill(last, -1);",
      "        int maxLen = 0, left = 0;",
      "        for (int right = 0; right < s.length(); right++) {",
      "            char c = s.charAt(right);",
      "            if (last[c] >= left) left = last[c] + 1;",
      "            last[c] = right;",
      "            maxLen = Math.max(maxLen, right - left + 1);",
      "        }",
      "        return maxLen;",
      "    }",
      "}"
    ],
    "time": "O(n)",
    "space": "O(min(n, m))",
    "tests": [
      { "id": "01", "name": "\"abcabcbb\"", "res": "len 3 (\"abc\")" },
      { "id": "02", "name": "\"bbbbb\"", "res": "len 1 (\"b\")" },
      { "id": "03", "name": "\"pwwkew\"", "res": "len 3 (\"wke\")" }
    ],
    "visualization": "sliding-window",
    "runtime": "2ms (99.4%)",
    "memory": "42.9MB"
  },
