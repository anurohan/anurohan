      { "id": "02", "name": "[3,2,4], 6", "res": "[1, 2]" },
      { "id": "03", "name": "[3,3], 6", "res": "[0, 1]" }
    ],
    "visualization": "hashmap",
    "runtime": "1ms (99.2%)",
    "memory": "44.2MB"
