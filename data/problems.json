    "title": "Climbing Stairs",
    "slug": "climbing-stairs",
    "difficulty": "Easy",
    "concept": "Dynamic Programming",
    "tag": "DP / Fibonacci",
    "inputDesc": "n = 5 stairs (1 or 2 steps each time)",
    "goalDesc": "Compute distinct ways to reach top using state recurrence",
    "javaCode": [
      "class Solution {",
      "    public int climbStairs(int n) {",
      "        if (n <= 2) return n;",
      "        int prev2 = 1, prev1 = 2;",
      "        for (int i = 3; i <= n; i++) {",
      "            int curr = prev1 + prev2;",
      "            prev2 = prev1;",
      "            prev1 = curr;",
      "        }",
      "        return prev1;",
      "    }",
      "}"
    ],
    "time": "O(n)",
    "space": "O(1)",
    "tests": [
