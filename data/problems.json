    "title": "Best Time to Buy & Sell Stock",
    "slug": "best-time-to-buy-and-sell-stock",
    "difficulty": "Easy",
    "concept": "Greedy / Single Pass",
    "tag": "Array / Optimization",
    "inputDesc": "prices = [7, 1, 5, 3, 6, 4]",
    "goalDesc": "Maximize single buy/sell profit by tracking min price",
    "javaCode": [
      "class Solution {",
      "    public int maxProfit(int[] prices) {",
      "        int minPrice = Integer.MAX_VALUE, maxProfit = 0;",
      "        for (int p : prices) {",
      "            minPrice = Math.min(minPrice, p);",
      "            maxProfit = Math.max(maxProfit, p - minPrice);",
      "        }",
      "        return maxProfit;",
      "    }",
      "}"
    ],
    "time": "O(n)",
    "space": "O(1)",
    "tests": [
