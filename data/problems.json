    "title": "Reverse Linked List",
    "slug": "reverse-linked-list",
    "difficulty": "Easy",
    "concept": "Linked List",
    "tag": "Pointers / Iterative",
    "inputDesc": "head = [1] -> [2] -> [3] -> [4] -> NULL",
    "goalDesc": "Reverse singly-linked list in O(n) time, O(1) space",
    "javaCode": [
      "class Solution {",
      "    public ListNode reverseList(ListNode head) {",
      "        ListNode prev = null, curr = head;",
      "        while (curr != null) {",
      "            ListNode nextTemp = curr.next;",
      "            curr.next = prev;",
      "            prev = curr;",
      "            curr = nextTemp;",
      "        }",
      "        return prev;",
      "    }",
      "}"
    ],
    "time": "O(n)",
    "space": "O(1)",
    "tests": [
