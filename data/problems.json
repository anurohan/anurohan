  {
    "id": 704,
    "title": "Binary Search",
    "slug": "binary-search",
    "difficulty": "Easy",
    "concept": "Binary Search",
    "tag": "Divide & Conquer",
    "inputDesc": "nums = [-1, 0, 3, 5, 9, 12], target = 9",
    "goalDesc": "Find index of target in sorted array in O(log n)",
    "javaCode": [
      "class Solution {",
      "    public int search(int[] nums, int target) {",
      "        int left = 0, right = nums.length - 1;",
      "        while (left <= right) {",
      "            int mid = left + (right - left) / 2;",
      "            if (nums[mid] == target) return mid;",
      "            else if (nums[mid] < target) left = mid + 1;",
      "            else right = mid - 1;",
      "        }",
      "        return -1;",
      "    }",
      "}"
    ],
    "time": "O(log n)",
    "space": "O(1)",
    "tests": [
